# EditorConfig — consistent whitespace across editors for everyone
# working on Elder-O-Buddy. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,json,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
