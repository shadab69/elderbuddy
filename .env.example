# ==============================================================================
# BuilderPro Marketplace - Email & Notification Configuration
# ==============================================================================

# Port
PORT=3000

# MongoDB URI (Optional: uses local JSON files automatically if empty)
# MONGODB_URI=mongodb://localhost:27017/builderpro

# Admin Recipient Email (Where customer query forms & orders will be sent)
ADMIN_EMAIL=your_email@gmail.com

# SMTP Provider (e.g. 'gmail', 'smtp.hostinger.com', 'smtp.office365.com', etc.)
EMAIL_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Sender Email Address (e.g. your Gmail ID)
EMAIL_USER=your_email@gmail.com

# Gmail App Password (Generate from: https://myaccount.google.com/apppasswords)
EMAIL_PASS=your_16_digit_app_password
