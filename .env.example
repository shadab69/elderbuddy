# ==============================================================================
# Elder-O-Buddy - Environment Configuration (copy to `.env`, fill real values)
# NEVER commit a real `.env` file or any credential to git.
# ==============================================================================

# --- Server ---
# Port the Express backend listens on
PORT=3000
# NODE_ENV: "development" (relaxes the admin-token rule, see below) or
# "production" (default behaviour everywhere else)
NODE_ENV=production

# --- Database ---
# MongoDB connection string. OPTIONAL: if unset/unreachable, the catalogue
# GET APIs automatically serve from the JSON seed files in backend/data/.
MONGODB_URI=mongodb://127.0.0.1:27017/builderpro

# --- Admin API security ---
# Shared secret required in the `x-admin-token` header (or
# `Authorization: Bearer <token>`) for ALL write/admin API calls and for
# reading /api/leads and /api/orders.
# If unset: writes are REJECTED, except when NODE_ENV=development, where they
# are allowed with a console warning (local development only).
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API.
# Defaults (when unset): http://localhost:5173,http://localhost:3000
# In production set this to your deployed site origin, e.g.
# ALLOWED_ORIGINS=https://your-site.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email / SMTP (credentials live ONLY here, never in code or git) ---
# Admin recipient email (order/inquiry notifications are sent here)
ADMIN_EMAIL=your_email@gmail.com
# SMTP service key ('gmail' uses the Gmail transport; otherwise SMTP_HOST is used)
SMTP_SERVICE=gmail
# EMAIL_SERVICE is accepted as a legacy alias of SMTP_SERVICE
EMAIL_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Sender account (SMTP_USER is canonical; EMAIL_USER is a legacy alias)
SMTP_USER=your_email@gmail.com
EMAIL_USER=your_email@gmail.com
# App password for the sender account (for Gmail, generate one at
# https://myaccount.google.com/apppasswords). SMTP_PASS is canonical;
# EMAIL_PASS is accepted as a legacy alias.
SMTP_PASS=your_app_password
EMAIL_PASS=your_app_password
# Notification switches (true/false)
NOTIFY_ON_INQUIRY=true
NOTIFY_ON_ORDER=true
